{
  "name": "AutoDev (dev)",
  "url": "http://localhost:3000",
  "hook_attributes": { "url": "https://YOUR-TUNNEL.example.com/webhooks/github", "active": true },
  "redirect_url": "http://localhost:3000",
  "callback_urls": ["http://localhost:3000/api/auth/callback/github"],
  "setup_url": "http://localhost:3000/api/github/setup",
  "setup_on_update": true,
  "request_oauth_on_install": false,
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "metadata": "read",
    "members": "read"
  },
  "default_events": ["member", "membership", "organization", "pull_request", "push", "repository", "team", "team_add"]
}
