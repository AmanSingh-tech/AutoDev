{
  "name": "autodev",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @autodev/db generate",
    "db:migrate": "pnpm --filter @autodev/db migrate",
    "db:seed": "pnpm --filter @autodev/db seed",
    "e2e": "pnpm --filter @autodev/e2e e2e",
    "blobs:migrate": "pnpm --filter @autodev/storage migrate --"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
