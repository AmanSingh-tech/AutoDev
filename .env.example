# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Postgres (docker-compose maps 5433 -> 5432) ----
# Request paths: RLS is enforced for this role.
DATABASE_URL=postgres://autodev_app:autodev_app@localhost:5433/autodev
# Migrations, webhook routing, cron jobs only (BYPASSRLS).
DATABASE_URL_SYSTEM=postgres://autodev_system:autodev_system@localhost:5433/autodev

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=autodev
S3_ACCESS_KEY_ID=autodev
S3_SECRET_ACCESS_KEY=autodev-secret
S3_FORCE_PATH_STYLE=true

# ---- Encryption ----
# Generate with: openssl rand -base64 32
KMS_PROVIDER=local
MASTER_KEY=
MASTER_KEY_ID=local-v1

# ---- Builder gateway ----
GATEWAY_PORT=4100
# Public URL handed to the CLI at pairing.
BUILDER_GATEWAY_URL=ws://localhost:4100/builder

# ---- LLM ----
# Leave unset in real deployments. Tests/e2e point this at a mock. Admins can't change where keys go.
# ANTHROPIC_BASE_URL=

# ---- Auth.js ----
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# ---- GitHub App (see docs/github-app.md) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM on one line with literal \n between lines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Blob storage. Postgres is the default. S3 works with any S3-compatible endpoint (MinIO in docker-compose).
# Move existing blobs with: pnpm blobs:migrate --to s3   (then set BLOB_DRIVER=s3)
BLOB_DRIVER=postgres
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=autodev
# S3_KEY=autodev
# S3_SECRET=autodev-secret

# Code index (worker). The embedding model (about 160 MB) is downloaded here on first use.
# EMBEDDINGS_CACHE_DIR=/var/cache/autodev/embeddings

# Group Agent (worker): where dependency scans look up advisories and latest versions.
# OSV_API_URL=https://api.osv.dev
# NPM_REGISTRY_URL=https://registry.npmjs.org
# PYPI_URL=https://pypi.org
# GOPROXY_URL=https://proxy.golang.org

# Billing (B-6). Leave STRIPE_SECRET_KEY empty and billing is off: every feature works without a plan.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from the Stripe webhook pointing at {API}/webhooks/stripe
# STRIPE_PRICE_TEAM=price_...              # recurring, per-unit (per seat) prices
# STRIPE_PRICE_BUSINESS=price_...
# TRIAL_DAYS=14
# NEXT_PUBLIC_SALES_URL=mailto:you@example.com   # web: where the Enterprise card links (hidden if unset)

# Enterprise controls (B-7)
# DATA_REGION=us                 # this deployment's region; orgs from other regions are refused
# TRUST_PROXY=1                  # proxies in front of the API (for client addresses and IP allowlists)
# OUTBOUND_ALLOW_PRIVATE=0       # 1 = allow http:// and private SIEM endpoints (development only)

# Single sign-on and directory sync through WorkOS (B-7). Off without the key and client id.
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...
# WORKOS_WEBHOOK_SECRET=...      # from the WorkOS webhook pointing at {API}/webhooks/workos
